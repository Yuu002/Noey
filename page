import pandas as pd
import numpy as np
import pickle
from sklearn.metrics import mean_absolute_error, mean_squared_error
from statsmodels.tsa.arima.model import ARIMA

# config
data_path = "sale_forecast_model/data/processed/monthly_sales.csv"
output_path = "sale_forecast_model/models/arima_model.pkl"

arima_order = (0,0,1)
min_train_size = 12
forecast_horizon = 1

# load data
df = pd.read_csv(data_path)

y = df["sales"].reset_index(drop=True)
months = df["month"].reset_index(drop=True)

print(f"Total odservations: {len(y)}")

# walk-forward validation
actuals = []
predictions = []
test_months = []

for t in range(min_train_size, len(y)):
    train_y = y.iloc[:t]
    test_y = y.iloc[t]

    model = ARIMA(train_y, order=arima_order)
    fit = model.fit()

    forecast = fit.forecast(steps=forecast_horizon).iloc[0]

    actuals.append(test_y)
    predictions.append(forecast)
    test_months.append(months[t])

# evaluation
actuals = np.array(actuals)
predictions = np.array(predictions)

mae = mean_absolute_error(actuals, predictions)
rmse = np.sqrt(mean_squared_error(actuals, predictions))
mape = np.mean(np.abs((actuals-predictions)/actuals))*100

print("\nWalk-forward validation result")

for m, a, p in zip(test_months, actuals, predictions):
    print(f"{m} | actual: {a:2f} | forecast: {p:2f}")

print(f"\nMAE: {mae:2f}")
print(f"\nRMSE: {mae:2f}")
print(f"\nMAPE: {mape:2f}%")

# traian final model
final_model = ARIMA(y, order=arima_order)
final_fit = final_model.fit()

print(f"\nFinal ARIMA model trained with full data")

