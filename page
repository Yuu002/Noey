/** @odoo-module **/

import {Component, onMounted} from "@odoo/owl";
import {useService} from "@web/core/utils/hooks";
import {registry} from "@web/core/registry";

export class SaleMonthlyForecastChart extends Component {
    setup() {
        this.orm = useService("orm");

        onMounted(() => {
            this.renderChart();
        });
    }

    async renderChart() {
        this.el.innerHTML = "";

        const canvas = document.createElement("canvas");
        canvas.style.width = "100%";
        canvas.style.height = "400px";
        this.el.appendChild(canvas);

        const result = await this.orm.call(
            "sale.monthly.forecast",
            "get_actual_sales_chart_data",
            [],
            {}
        );

        if (!result || !result.labels) {
            return;
        }

        const ctx = canvas.getContext("2d");

        new Chart(ctx, {
            type: "line",
            data: {
                labels: result.labels,
                datasets: [
                    {
                        label: "Actual Sales",
                        data: result.actual,
                        borderWidth: 2,
                        tension: 0.3,
                    },
                ],
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: "top",
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    },
                },
            },
        });
    }
}

registry.category("view_widgets").add(
    "sale_monthly_forecast_chart",
    SaleMonthlyForecastChart
);

