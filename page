from odoo import models, api
from collections import defaultdict
from datetime import date

class ProfitLossReport(models.AbstractModel):
    _name = "report.account.profit.loss"
    _description = "Monthly Profit and Loss Report"

    @api.model
    def get_monthly_profit_loss(self, year):
        company_id = self.env.company.id
        result = defaultdict(lambda: {"income": 0.0, "cogs": 0.0})

        domain = [
            ("move_id.state", "=", company_id),
            ("move_id.company_id", "=", company_id),
            ("move_id.date", ">=", f"{year}-01-01"),
            ("move_id.date", "<=", f"{year}-12-31"),
        ]

        lines = self.env["account.move.line"].search(domain)

        for line in lines:
            month = line.move_id.date.strftime("%Y-%m")

            # Income: 41000 (Customer Invoice)
            if (
                line.move_id.move_type == "out_invoice"
                and line.account_id.code == "41000"
            ):
                result[month]["income"] += line.credit - line.debit

            # COGS: 51xxx (Vendor Bill)
            if (
                line.move_id.move_type == "in_invoice"
                and line.account_id.code
                and line.account_id.code.startswith("51")
            ):
                result[month]["cogs"] += line.debit - line.credit

        data = []
        for month in sorted(result.keys()):
            income = result[month]["income"]
            cogs = result[month]["cogs"]
            profit = income - cogs

            data.append({
                "month": month,
                "income": round(income, 2),
                "cogs": round(cogs, 2),
                "profit": round(profit, 2),
            })
        return data

