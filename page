# -*- coding: utf-8 -*-
import pickle
import pandas as pd
from pathlib import Path
from dateutil.relativedelta import relativedelta


# path config
base_dir = Path(__file__).resolve().parents[1]
model_path = base_dir / "data" / "arima_model.pkl"


# load trained model
def load_model():
    if not model_path.exists():
        raise FileNotFoundError(
            f"ARIMA model not found at {model_path}"
        )

    with open(model_path, "rb") as f:
        model = pickle.load(f)

    return model


# forecast next months
def forecast_next_month(monthly_sales):
    """
    monthly_sales : list of dict
    [
        {"month": "2023-01", "sales": 1200.0},
        ...
    ]
    """

    if not monthly_sales or len(monthly_sales) < 12:
        raise ValueError(
            "At least 12 months of sales data are required."
        )

    # convert to DataFrame
    df = pd.DataFrame(monthly_sales)
    df["month"] = pd.to_datetime(df["month"])
    df = df.sort_values("month")

    y = df["sales"].astype(float)

    # Load model
    model = load_model()

    # Forecast 1 step ahead
    forecast_value = model.forecast(steps=1).iloc[0]

    # next month
    last_month = df["month"].iloc[-1]
    next_month = last_month + relativedelta(months=1)

    return {
        "forecast_month": next_month.strftime("%Y-%m"),
        "forecast_sales": round(float(forecast_value), 2),
        "model": "ARIMA",
    }
