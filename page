import pandas as pd

# config
raw_data_path = "sale_forecast_model/data/raw/sales.csv"
output_path = "sale_forecast_model/data/processed/monthly_sales.csv"
import pandas as pd

data_col = "Order_Date"
sales_col = "Unit_Price"

# load data
df = pd.read_csv(raw_data_path)

print("Raw data shape:", df.shape)
print(df.head)
print("\nMissing values:")
print(df.isna().sum())

# clean data
df = df.dropna(subset=[data_col])
df[data_col] = pd.to_datetime(df[data_col], dayfirst=True, errors="coerce")
df[sales_col] = df[sales_col].fillna(0)

# aggregate to monthly
monthly = (df.groupby(pd.Grouper(key=data_col, freq="MS"))[sales_col].sum().reset_index())

# finalize columns
monthly = monthly.rename(columns={data_col: "month", sales_col: "sales"})
monthly = monthly.sort_values(by="month").reset_index(drop=True)
monthly["month"] = monthly["month"].dt.strftime("%Y-%m")

print("\nMonthly sales preview:")
print(monthly)
