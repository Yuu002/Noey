                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                    },
                    {
                        label: "Forecast Connection",
                        data: result.connection,
                        borderColor: "#b62728",
                        borderWidth: 2,
                        tension: 0.3,
                        fill: false,
                        pointRadius: 0,
