import pandas as pd
from statsmodels.tsa.stattools import adfuller, kpss

def find_d(series, max_d=2, alpha=0.05, verbose=True):
    y = series.copy()

    for d in range(max_d+1):
        adf_p = adfuller(y.dropna(), regression="ct")[1]
        kpss_p = kpss(y.dropna(), regression="c", nlags="auto")[1]

        if verbose:
            print(f"d = {d} | ADF p-value = {adf_p:.4f} | KPSS p-value = {kpss_p:.4f}")

        if adf_p < alpha and kpss_p > alpha:
                print(f"Stationary ที่ d = {d}")
                return d
        y = y.diff()

    if verbose:
        print(" ยังไม่ได้ Stationary แม้ diff สูงสุดแล้ว")
    return max_d

df = pd.read_csv("sale_forecast_model/data/processed/monthly_sales.csv")
df["month"] = pd.to_datetime(df["month"])
df.set_index("month", inplace=True)

y = df["sales"]
train = y.iloc[:23]

d = find_d(train)
print("select d =", d)
