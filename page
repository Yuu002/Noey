export class SaleMonthlyForecastChart extends Component {
    setup() {
        this.orm = useService("orm");
        this.chartRef = useRef("chart");

        onMounted(() => {
            this.renderChart();
        });
    }

    async renderChart() {
        const result = await this.orm.call(
            "sale.monthly.forecast",
            "get_forecast_chart_data", [], {}
        );

        if (!result) {
            return;
        }

        const labels = [...result.labels, result.forecast_label];
        const actualData = [...result.actual, null];
        const forecastData = new Array(result.actual.length).fill(null);
        forecastData.push(result.forecast_value);

        const ctx = this.chartRef.el.getContext("2d");

