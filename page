from odoo import models, fields, api
from datetime import datetime
from dateutil.relativedelta import relativedelta

class SalesReportWizard(models.TransientModel):
    _name = 'sales.performance.wizard'
    _description = 'Sales Performance Report Wizard'

    start_date = fields.Date(string="Start Date")
    end_date = fields.Date(string="End Date")
    display_product_details = fields.Boolean(string="Display Product Details", default=True)

    def action_print_report(self):
        domain = [('move_id.state', '=', 'posted'), ('move_id.move_type', '=', 'out_invoice')]
        
        if self.start_date:
            domain.append(('date', '>=', self.start_date))
        if self.end_date:
            domain.append(('date', '<=', self.end_date))

        lines = self.env['account.move.line'].search(domain).filtered(lambda l: l.product_id)

        monthly_dict = {}
        for line in lines:
            month_key = line.date.strftime('%b %Y').upper() # เช่น 'OCT 2023'
            if month_key not in monthly_dict:
                monthly_dict[month_key] = {'total': 0.0, 'products': {}}
            
            monthly_dict[month_key]['total'] += line.price_subtotal
            
            if self.display_product_details:
                prod_name = line.product_id.name
                monthly_dict[month_key]['products'][prod_name] = monthly_dict[month_key]['products'].get(prod_name, 0.0) + line.price_subtotal

        current_year = datetime.now().year
        yearly_lines = self.env['account.move.line'].search([
            ('move_id.state', '=', 'posted'),
            ('move_id.move_type', '=', 'out_invoice'),
            ('date', '>=', datetime(current_year, 1, 1)),
            ('date', '<=', datetime(current_year, 12, 31))
        ]).filtered(lambda l: l.product_id)
        yearly_total = sum(yearly_lines.mapped('price_subtotal'))

        all_lines = self.env['account.move.line'].search([
            ('move_id.state', '=', 'posted'),
            ('move_id.move_type', '=', 'out_invoice')
        ]).filtered(lambda l: l.product_id)

        grand_total = sum(all_lines.mapped('price_subtotal'))

        data = {
            'start_date': self.start_date,
            'end_date': self.end_date,
            'display_product_details': self.display_product_details,
            'monthly_data': monthly_dict,
            'yearly_total': yearly_total,
            'grand_total': grand_total,
            'printed_date': fields.Date.today().strftime('%Y-%m-%d'),
        }
        return self.env.ref('custom_sales_report.action_report_sales_perf').report_action(self, data=data)

