/** @odoo-module **/

import { Component, onMounted } from "@odoo/owl";
import { useService } from "@web/core/utils/hooks";

export class SaleMonthlyForecastChart extends Component {
    setup() {
        this.orm = useService("orm");

        onMounted(() => {
            this.renderActualChart(); // เปลี่ยน: วาดกราฟทันที
        });
    }

    async renderActualChart() {
        // เปลี่ยน: หา canvas จาก DOM โดยตรง
        const canvas = document.querySelector(
            ".o_sale_monthly_forecast_chart"
        );

        if (!canvas) {
            return;
        }

        // เปลี่ยน: เรียก method สำหรับ Actual อย่างเดียว
        const result = await this.orm.call(
            "sale.monthly.forecast",
            "get_actual_sales_chart_data",
            [],
            {}
        );

        const ctx = canvas.getContext("2d");

        // เปลี่ยน: วาดเฉพาะเส้นฟ้า
        this.chart = new Chart(ctx, {
            type: "line",
            data: {
                labels: result.labels,
                datasets: [
                    {
                        label: "Actual Sales",
                        data: result.actual,
                        borderWidth: 2,
                        tension: 0.3,
                    },
                ],
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: "top",
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    },
                },
            },
        });
    }
}

