# -*- coding: utf-8 -*-

from odoo import models, fields, api
from odoo.exceptions import UserError
from collections import defaultdict
from datetime import datetime
from .predict import forecast_next_month

class SaleMonthlyForecast(models.Model):
    _name = "sale.monthly.forecast"
    _description = "Monthly Sales Forecast (ARIMA)"
    _rec_name = "name"

    name = fields.Char(
        string="Name",
        default="Monthly Sales Forecast",
        readonly=True
    )

    forecast_month = fields.Char(
        string="Forecast Month",
        readonly=True
    )

    forecast_sales = fields.Float(
        string="Forecast Sales",
        readonly=True
    )

    # core method
    def action_compute_forecast(self):
        """
        1) Pull sale.order from Odoo
        2) Aggregate sales by month
        3) Call predict.py
        4) Save forecast result
        """

        # 1) fetch confirmed sales orders
        orders = self.env["sale.order"].search([
            ("state", "in", ["sale", "done"]),
            ("date_order", "!=", False)
        ], order="date_order ASC")

        if not orders:
            raise UserError("No confirmed sales orders found.")

        # 2) aggregate monthly sales
        monthly_totals = defaultdict(float)

        for order in orders:
            order_date = fields.Datetime.to_datetime(order.date_order)
            month_key = order_date.strftime("%Y-%m")
            monthly_totals[month_key] += order.amount_total

        monthly_sales = [
            {"month": month, "sales": monthly_totals[month]}
            for month in sorted(monthly_totals.keys())
        ]

        # 3) call forecast function
        try:
            result = forecast_next_month(monthly_sales)
        except Exception as e:
            raise UserError(str(e))

        # 4) save result to record
        self.write({
            "forecast_month": result["forecast_month"],
            "forecast_sales": result["forecast_sales"],
        })

        return True

    # data for chart (used by js)
    @api.model
    def get_forecast_chart_data(self, record_id):
        record = self.browse(record_id)
        if not record.exists():
            return {}

        orders = self.env["sale.order"].search([
            ("state", "in", ["sale", "done"]),
            ("date_order", "!=", False)
        ], order="date_order ASC")

        monthly_totals = defaultdict(float)

        for order in orders:
            order_date = fields.Datetime.to_datetime(order.date_order)
            month_key = order_date.strftime("%B %Y")
            monthly_totals[month_key] += order.amount_total

        labels = list(monthly_totals.keys())
        actual = list(monthly_totals.values())

        forecast = []
        if record.forecast_month and record.forecast_sales:
            labels.append(record.forecast_month)
            actual.append(None)
            forecast = [None] * (len(actual)-1) + [record.forecast_sales]

        return {
            "labels": labels,
            "actual": actual,
            "forecast": forecast,
        }

