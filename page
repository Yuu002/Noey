/** @odoo-module **/

import {registry} from "@web/core/registry";
import {Component, onMounted} from "@odoo/owl";
import {useService} from "@web/core/utils/hooks";

export class ProfitLossDashboard extends Component {
    setup() {
        this.orm = useService("orm");
        onMounted(() => {
            this.renderChart();
        });
    }

    async renderChart() {
        let data;
        try {
            data = await this.orm.call(
                "report.account.profit.loss",
                "get_monthly_profit_loss",
                [new Date().getFullYear()]
            );
        } catch(error) {
            console.error("RPC error while fetching P&L data", error);
            return;
        }

        if(!Array.isArray(data) || !data.length) {
            console.warn("No date for Profit&Loss chart", data);
            return;
        }

        const canvas = document.getElementById("profitLossChart");
        if(!canvas) {
            console.error("Canvas #profitLossChart not found");
            return;
        }

        const ctx = canvas.getContext("2d");
        if(this.chart) {
            this.chart.destroy();
        }

        const labels = data.map(d => d.month);
        const income = data.map(d => d.income);
        const cogs = data.map(d => d.cogs);
        const profit = data.map(d => d.profit);

        this.chart = new Chart(ctx, {
            data: {
                labels: labels,
                datasets: [
                    {
                        label: "Income",
                        date: income,
                        type: "bar",
                    },
                    {
                        label: "COGS",
                        date: cogs,
                        type: "bar",
                    },
                    {
                        label: "Profit/Loss",
                        date: profit,
                        type: "line",
                        tension: 0.3,
                    },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: "top",
                    },
                    tooltip: {
                        mode: "index",
                        intersect: false,
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    },
                },
            },
        });
    }
}
