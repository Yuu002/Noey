import pandas as pd
import numpy as np
from sklearn.metrics import mean_absolute_error
from statsmodels.tsa.holtwinters import SimpleExpSmoothing, Holt
from statsmodels.tsa.arima.model import ARIMA

# load data
df = pd.read_csv("sale_forecast_model/data/processed/monthly_sales.csv")

y = df["sales"].reset_index(drop=True)
months = df["month"].reset_index(drop=True)

# parameters
min_train_size = 12
forecast_horizon = 1

# evaluation function
def evaluate(name, actual, pred):
    actual = np.asarray(actual)
    pred = np.asarray(pred)

    mae = mean_absolute_error(actual, pred)
    mape = np.mean(2*np.abs(pred-actual)/(np.abs(actual)+np.abs(pred))) * 100

    return {
        "model": name,
        "MAE": round(mae, 2),
        "MAPE": round(mape, 2)
    }

results = []

# ===============================
# 1) NAIVE
# ===============================
actuals, preds = [], []

for t in range(min_train_size, len(y)):
    train = y[:t]
    actuals.append(y[t])
    preds.append(train.iloc[-1])

results.append(evaluate("Naive", actuals, preds))

# ===============================
# 2) Moving Average
# ===============================
for w in [3, 4, 5, 6]:
    actuals, preds = [], []

    for t in range(min_train_size, len(y)):
        train = y[:t]
        if len(train) < w:
            continue
        actuals.append(y[t])
        preds.append(train.rolling(w).mean().iloc[-1])

    results.append(evaluate(f"MA{w}", actuals, preds))

# ===============================
# 3) SES
# ===============================
for alpha in [0.2, 0.3, 0.4, 0.5]:
    actuals, preds = [], []

    for t in range(min_train_size, len(y)):
        train = y[:t]
        model = SimpleExpSmoothing(train, initialization_method="estimated")
        fit = model.fit(smoothing_level=alpha, optimized=False)

        forecast = fit.forecast(forecast_horizon)
        actuals.append(y[t])
        preds.append(forecast.iloc[0])

    results.append(evaluate(f"SES α={alpha}", actuals, preds))

# ===============================
# 4) HOLT
# ===============================
holt_params = [(0.3, 0.1), (0.4, 0.1), (0.4, 0.2)]

for alpha, beta in holt_params:
    actuals, preds = [], []

    for t in range(min_train_size, len(y)):
        train = y[:t]
        model = Holt(train, initialization_method="estimated")
        fit = model.fit(
            smoothing_level=alpha,
            smoothing_trend=beta,
            optimized=False
        )

        forecast = fit.forecast(forecast_horizon)
        actuals.append(y[t])
        preds.append(forecast.iloc[0])

    results.append(evaluate(f"Holt a={alpha}, b={beta}", actuals, preds))

# ===============================
# 5) ARIMA
# ===============================
arima_orders = [(2,0,1), (1,1,1), (0,0,1), (2,1,1)]

for order in arima_orders:
    actuals, preds = [], []

    for t in range(min_train_size, len(y)):
        train = y[:t]
        model = ARIMA(train, order=order)
        fit = model.fit()

        forecast = fit.forecast(forecast_horizon)
        actuals.append(y[t])
        preds.append(forecast.iloc[0])

    results.append(evaluate(f"ARIMA{order}", actuals, preds))

# ===============================
# Result table
# ===============================
result_df = pd.DataFrame(results).sort_values("MAE")

print("\n===== WALK-FORWARD VALIDATION RESULTS =====")
print(result_df.to_string(index=False))
