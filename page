/** @odoo-module **/

import { registry } from "@web/core/registry";
import { Component, onMounted } from "@odoo/owl";
import { useService } from "@web/core/utils/hooks";

export class ProfitLossDashboard extends Component {
    setup() {
        this.orm = useService("orm");
        this.action = useService("action");

        onMounted(() => {
            this.renderChart();
        });
    }

    async renderChart() {
        let data;
        try {
            data = await this.orm.call(
                "report.account.profit.loss",
                "get_monthly_profit_loss",
                [new Date().getFullYear()]
            );
        } catch (error) {
            console.error("RPC error", error);
            return;
        }

        if (!Array.isArray(data) || !data.length) return;

        const canvas = document.getElementById("profitLossChart");
        if (!canvas) return;

        const ctx = canvas.getContext("2d");

        if (this.chart) {
            this.chart.destroy();
        }

        const labels = data.map(d => {
            const [y, m] = d.month.split("-");
            return new Date(y, m - 1).toLocaleString("en-US", {
                month: "long",
                year: "numeric",
            });
        });

        this.chart = new Chart(ctx, {
            type: "bar",
            data: {
                labels,
                datasets: [
                    {
                        label: "Income",
                        data: data.map(d => d.income),
                        backgroundColor: "#4caf50",
                        order: 2,
                    },
                    {
                        label: "COGS",
                        data: data.map(d => d.cogs),
                        backgroundColor: "#f44336",
                        order: 2,
                    },
                    {
                        label: "Profit & Loss",
                        data: data.map(d => d.profit),
                        type: "line",
                        borderColor: "#2196f3",
                        backgroundColor: "rgba(33,150,243,0.15)",
                        tension: 0.3,
                        fill: true,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        order: 1,
                    },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,

                interaction: {
                    mode: "nearest",
                    intersect: true,
                },

                onHover: (evt, activeEls) => {
                    evt.native.target.style.cursor =
                        activeEls.length ? "pointer" : "default";
                },

                onClick: (evt, activeEls) => {
                    if (!activeEls.length) return;

                    const el = activeEls[0];
                    const dataset = this.chart.data.datasets[el.datasetIndex];
                    const index = el.index;

                    const month = data[index].month;

                    // ✅ LINE → Profit / Loss
                    if (dataset.type === "line") {
                        this.openProfitDetailView(month, data[index].profit);
                        return;
                    }

                    // ✅ BAR → Income / COGS
                    if (dataset.label === "Income" || dataset.label === "COGS") {
                        this.openBarDetailView(month, dataset.label);
                    }
                },

                plugins: {
                    legend: {
                        position: "top",
                    },
                    tooltip: {
                        intersect: true,
                    },
                },

                scales: {
                    y: {
                        beginAtZero: true,
                    },
                },
            },
        });
    }

    openBarDetailView(month, type) {
        const [year, m] = month.split("-");
        const dateFrom = `${year}-${m}-01`;
        const dateTo = `${year}-${m}-31`;

        const domain = [
            ["move_id.state", "=", "posted"],
            ["date", ">=", dateFrom],
            ["date", "<=", dateTo],
        ];

        if (type === "Income") {
            domain.push(["account_id.code", "like", "41%"]);
        }

        if (type === "COGS") {
            domain.push(["account_id.code", "like", "51%"]);
        }

        this.action.doAction({
            type: "ir.actions.act_window",
            name: `${type} (${month})`,
            res_model: "account.move.line",
            views: [
                [false, "list"],
                [false, "form"],
            ],
            domain,
            target: "current",
            context: {
                search_default_group_by_move: 1,
            },
        });
    }

    openProfitDetailView(month, profitValue) {
        const [year, m] = month.split("-");
        const dateFrom = `${year}-${m}-01`;
        const dateTo = `${year}-${m}-31`;

        this.action.doAction({
            type: "ir.actions.act_window",
            name: `Profit & Loss (${month}) = ${profitValue.toLocaleString()}`,
            res_model: "account.move.line",
            views: [
                [false, "list"],
                [false, "form"],
            ],
            domain: [
                ["move_id.state", "=", "posted"],
                ["date", ">=", dateFrom],
                ["date", "<=", dateTo],
                "|",
                ["account_id.code", "like", "41%"],
                ["account_id.code", "like", "51%"],
            ],
            target: "current",
            context: {
                search_default_group_by_move: 1,
            },
        });
    }
}

ProfitLossDashboard.template = "ProfitLossDashboard";

registry.category("actions").add(
    "profit_loss_dashboard",
    ProfitLossDashboard
);
