                    {
                        label: "Forecast",
                        data: result.forecast,
                        borderColor: "#d62728",
                        backgroundColor: "rgba(214,39,40,0.2)",
                        borderDash: [5, 5],
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 5,
                    },
                ],
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: "top",
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    },
                },
            },
        });
    }
}

