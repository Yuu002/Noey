import pandas as pd
import numpy as np
import pickle
from sklearn.metrics import mean_absolute_error
from statsmodels.tsa.arima.model import ARIMA

# config
data_path = "sale_forecast_model/data/processed/monthly_sales.csv"
output_path = "sale_forecast_model/models/arima_model.pkl"

# load data
df = pd.read_csv(data_path)

y = df["sales"]
months = df["month"]

# train/test split
train = y.iloc[:23]
test = y.iloc[23:]

test_months = months.iloc[23:].reset_index(drop=True)
test = test.reset_index(drop=True)

print(f"Total data: {len(y)}")
print(f"Train size: {len(train)}")
print(f"Test size: {len(test)}")

# train ARIMA model(1,1,1)
model = ARIMA(train, order=(0,0,1))
fit = model.fit()

# forecast
forecast = fit.forecast(steps=len(test))
forecast = pd.Series(forecast).reset_index(drop=True)

# evaluate
mae = mean_absolute_error(test, forecast)
mape = np.mean(np.abs((test-forecast)/test))*100
smape = np.mean(2*np.abs(forecast-test)/(np.abs(test)+np.abs(forecast)))*100

print("\nTest Result")
for i in range(len(test)):
    print(f"{test_months[i]} | actual: {test[i]:.2f} | forecast: {forecast[i]:.2f}")

print(f"\nMAE: {mae:2f}")
print(f"MAPE: {mape:2f}%")
print(f"sMAPE: {smape:2f}%")

# save
with open(output_path, "wb") as f:
    pickle.dump(fit, f)
print(f"\nModel save to {output_path}")

