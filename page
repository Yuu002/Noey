/** @odoo-module **/

import {registry} from "@web/core/registry";
import {Component, onMounted, useRef} from "@odoo/owl";
import {useService} from "@web/core/utils/hooks";

export class SaleMonthlyForecastChart extends Component {
    setup() {
        this.orm = useService("orm");
        this.actionService = useService("action");
        this.chartRef = useRef("chart");

        onMounted(() => {
            this.renderChart();
        });
    }

    async renderChart() {
        const recordId = this.props.action.context.active_id;

        const result = await this.orm.call(
            "sale.monthly.forecast",
            "get_forecast_chart_data", [recordId], {}
        );

        if(!result || !this.chartRef.el) {
            return;
        }

        const ctx = this.chartRef.el.getContext("2d");

        new Chart(ctx, {
            type: "line",
            data: {
                labels: result.labels,
                datasets: [{
                        label: "Actual Sales",
                        data: result.actual,
                        borderColor: "#469fdf",
                        backgroundColor: "rgba(31,119,180,0.2)",
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                    },
                    {
                        label: "connection",
                        data: result.connection,
                        borderColor: "#df6666",
                        backgroundColor: "rgba(255, 126, 126, 0.23)",
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 0,
                    },
                    {
                        label: "Forecast",
                        data: result.forecast,
                        borderColor: "#df6666",
                        backgroundColor: "rgba(255, 110, 110, 0.23)",
                        borderDash: [5, 5],
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 5,
                    },
                ],
            },
            options: {
                responsive: true,

                onClick: (evt, elements) => {
                    if(!elements.length) return;

                    const element = elements[0];
                    if(element.datasetIndex !==0) return;

                    const index = element.index;
                    const label = result.labels[index];

                    this.openInvoiceReport(label);
                },
                onHover:(evt, elements) => {
                    const canvas = evt.native.target;
                    if(
                        elements.length &&
                        elements[0].datasetIndex === 0
                    ) {
                        canvas.style.cursor = "pointer";
                    } else {
                        canvas.style.cursor = "default";
                    }
                },

                plugins: {
                    legend: {
                        position: "top",
                        labels: {
                            filter: function(item) {
                                return item.text !== "connection";
                            }
                        }
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    },
                },
            },
        });
    }

    openInvoiceReport(label) {
        const {DateTime} = luxon;
        const date = DateTime.fromFormat(label, "MMMM YYYY", {locale: "en"});

        if(!date.isValid) {
            console.error("Invalid date label:", label);
            return;
        }

        const start = date.startOf("month").toISODate();
        const end = date.endOf("month").toISODate();

        this.actionService.doAction({
            type: "ir.actions.act_window",
            name: `Invoice Report ${label}`,
            res_model: "account.invoice.report",
            view_mode: "tree,pivot,graph",
            domain: [
                ["invoice_date", ">=", start],
                ["invoice_date", "<=", end],
            ],
        });
    }
}

