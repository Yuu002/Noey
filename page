<odoo>
    <template id="report_sales_perf_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="container">
                        <div class="text-center" style="border-bottom: 2px solid #333; padding-bottom: 10px;">
                            <h2 style="font-weight: bold; color: #1a4d80;">SALES PERFORMANCE REPORT</h2>
                            <span>Period: </span>
                            <span t-esc="start_date or 'Beginning'"/> to <span t-esc="end_date or 'Present'"/>
                        </div>

                        <div class="mt-4">
                            <h4><strong>1. MONTHLY OVERVIEW</strong></h4>
                            <t t-foreach="monthly_data" t-as="month_name">
                                <div style="padding-left: 20px; margin-bottom: 15px;">
                                    <p style="font-size: 1.1em; margin-bottom: 5px;">
                                        <strong><t t-esc="month_name"/>: <t t-esc="'{:,.2f}'.format(monthly_data[month_name]['total'])"/> THB</strong>
                                    </p>
                                    <ul t-if="display_product_details" style="list-style-type: none; padding-left: 20px; color: #555;">
                                        <t t-foreach="monthly_data[month_name]['products']" t-as="prod">
                                            <li>- <t t-esc="prod"/>: <t t-esc="'{:,.2f}'.format(monthly_data[month_name]['products'][prod])"/> THB</li>
                                        </t>
                                    </ul>
                                </div>
                            </t>
                        </div>

                        <div class="mt-4">
                            <h4><strong>2. YEARLY PERFORMANCE (YTD)</strong></h4>
                            <div style="padding-left: 20px;">
                                <p>- Total Sales this Year: <strong><t t-esc="'{:,.2f}'.format(yearly_total)"/> THB</strong></p>
                            </div>
                        </div>

                        <div class="mt-4" style="background-color: #f8f9fa; padding: 15px; border: 1px solid #dee2e6;">
                            <h4><strong>3. GRAND TOTAL REVENUE</strong></h4>
                            <h3 class="text-end" style="font-weight: bold; color: #1a4d80; margin-top: 10px;">
                                Cumulative Sales: <t t-esc="'{:,.2f}'.format(grand_total)"/> THB
                            </h3>
                        </div>

                        <div class="mt-5 text-muted text-end" style="font-size: 10px; border-top: 1px solid #ccc; padding-top: 5px;">
                            Printed on: <span t-esc="printed_date"/> | Status: All Posted Entries
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

